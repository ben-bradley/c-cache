{
  "name": "c-cache",
  "version": "0.3.0",
  "description": "Cluster-aware cache for Node.js workers with pluggable storage (default Map with max/ttl)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch --preserveWatchOutput",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:watch": "chokidar \"src/**/*.ts\" -c \"eslint src\" --initial",
    "dev": "concurrently -k -n build,lint -c blue,yellow \"npm run watch\" \"npm run lint:watch\"",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "prepare": "npm run build"
  },
  "keywords": [
    "cache",
    "cluster",
    "worker",
    "shared-cache",
    "ipc",
    "node.js",
    "lru",
    "redis",
    "multiprocess",
    "c-cache"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.1.0"
  }
}
